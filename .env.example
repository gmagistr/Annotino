# Leave empty to run Annotino in local mode (data stays in this browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# "Continue with GitHub": the Annotino GitHub App and the sign-in bridge (see bridge/README.md).
# Leave empty to sign in with a personal access token instead.
VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_APP_SLUG=
VITE_GITHUB_BRIDGE=
